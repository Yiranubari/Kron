# Server
PORT=3001

# Frontend URL (for generating portal links in webhook responses)
FRONTEND_URL=http://localhost:5173

# SMTP (Elastic Email)
SMTP_HOST=smtp.elasticemail.com
SMTP_PORT=2525
SMTP_ENCRYPTION=starttls
SMTP_USER=your-elastic-email@example.com
SMTP_PASS=your-elastic-email-api-key

# Sender details
FROM_EMAIL=your-elastic-email@example.com
FROM_NAME=Kron Billing
